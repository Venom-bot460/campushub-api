  "version": "1.0.0",
  "description": "Backend REST API for CampusHub, a platform for students to connect and collaborate on projects and internship activities.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
